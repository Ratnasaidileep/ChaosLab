# ==============================================================================
# ChaosLab Environment Configuration
# ==============================================================================

# ChaosLab Backend API
CHAOSLAB_PORT=8000
CHAOSLAB_HOST=0.0.0.0
CHAOSLAB_ENV=development
CHAOSLAB_DB_PATH=./data/chaoslab.db

# Microservices URLs (internal Docker network or localhost)
PRODUCT_SERVICE_URL=http://product-service:8001
ORDER_SERVICE_URL=http://order-service:8002

# Local development override (uncomment when running outside Docker):
# PRODUCT_SERVICE_URL=http://localhost:8001
# ORDER_SERVICE_URL=http://localhost:8002

# Health Polling & Recovery Engine
HEALTH_CHECK_INTERVAL_SECONDS=2
RECOVERY_TIMEOUT_SECONDS=45
DETECTION_TIMEOUT_SECONDS=30

# Docker Socket (used for container stop/restart when running in Docker mode)
DOCKER_HOST_SOCKET=/var/run/docker.sock
ENABLE_DOCKER_CHAOS=true

# Security & Safety Limits
MAX_EXPERIMENT_DURATION_SECONDS=60
MAX_CPU_LOAD_PERCENT=80
MAX_MEMORY_MB=350
ALLOWED_TARGET_SERVICES=product-service,order-service

# Monitoring Ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
FRONTEND_PORT=3000
